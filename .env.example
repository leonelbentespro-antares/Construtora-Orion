# UAZAPI CONFIGURATION
VITE_UAZAPI_SUBDOMAIN=your_subdomain
VITE_UAZAPI_TOKEN=your_instance_token
VITE_UAZAPI_ADMIN_TOKEN=your_admin_token
VITE_UAZAPI_INSTANCE_ID=your_instance_id

# PAGAMENTOS — ASAAS (opcional)
# Defina como "true" somente quando a Edge Function "asaas" estiver configurada
# e os secrets ASAAS_API_KEY + ASAAS_WEBHOOK_TOKEN estiverem definidos no Supabase.
VITE_ASAAS_ENABLED=false
